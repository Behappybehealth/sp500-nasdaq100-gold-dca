# ---- 本地用户数据与密钥不入库（保留默认配置与行情缓存，便于 Streamlit Cloud 直接运行）----
data/transactions.csv
data/observations.csv
data/budget_overrides.json
data/*.localbak
# 东财 XAU 实时价的落盘缓存（app.py 运行时生成，随时可重抓）
data/xau_spot_last.json
# 行情快照（dca_calculator 运行时生成的加速缓存，过期自动失效、缺失自动全抓）
data/quote_snapshot.json
# 汇率上次成功值兜底（引擎抓成功时刷新，失败时读它兜底；本地缓存）
data/fx_last.json
# 多用户模式下 sync_local 的每用户落盘缓存（BUG-001 修复后产生）
data/users/

# ---- 密钥 ----
.streamlit/secrets.toml
.env

# ---- 随项目走但不入库的二进制工具（33 MB，官网可重新下载）----
# 注意：只是不入库，文件本身留在 deploy/bin/，隧道脚本靠相对路径找它。
deploy/bin/

# ---- Python 环境与缓存 ----
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ---- 运行时日志与 PID ----
*.log
*.pid
# 运行日志目录内容（BUG-017 落点；目录本身由 logs/.gitkeep 占位入库）
logs/*.log

# ---- IDE ----
.idea/
.vscode/

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini
