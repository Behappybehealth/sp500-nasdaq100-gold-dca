# 复制本文件为 secrets.toml 并填入真实值（secrets.toml 已被 .gitignore 排除，不会上传）
# 部署到 Streamlit Cloud 时，把同样内容粘到应用后台的 Settings → Secrets 里

[connections.gsheets]
# 你的 Google 表格链接（表格需要"共享"给下面的 service account 邮箱，权限：编辑者）
spreadsheet = "https://docs.google.com/spreadsheets/d/你的表格ID/edit"

# 服务账号凭证（GCP Console → IAM → 服务账号 → 密钥 → 新建 JSON 密钥，整段照抄）
type = "service_account"
project_id = "你的GCP项目ID"
private_key_id = "密钥ID"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "xxx@你的项目.iam.gserviceaccount.com"
client_id = "数字ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/xxx"
